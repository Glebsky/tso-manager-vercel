{
    "version": 2,
    "framework": null,
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "functions": {
        "api/server.php": {
            "runtime": "vercel-php@0.9.0",
            "maxDuration": 30
        }
    },
    "env": {
        "APP_NAME": "TSO Public Market",
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_KEY": "base64:BU8JL1f6vmjiKr5fZJ8Raf3R3PoqZXigs+/gqVis5qM=",
        "APP_LOCALE": "en",
        "APP_FALLBACK_LOCALE": "en",
        "APP_TIMEZONE": "UTC",
        "MARKET_DEFAULT_SERVER_ID": "ru",
        "MARKET_CACHE_STRATEGY": "bulk",
        "DB_CONNECTION": "pgsql",
        "DB_HOST": "aws-0-eu-west-1.pooler.supabase.com",
        "DB_PORT": "5432",
        "DB_DATABASE": "postgres",
        "DB_USERNAME": "postgres.sibqukjvhwlzxgzhfxil",
        "DB_PASSWORD": "wonettehartin148_tx",
        "CACHE_STORE": "array",
        "CACHE_DRIVER": "array",
        "SESSION_DRIVER": "cookie",
        "QUEUE_CONNECTION": "sync",
        "LOG_CHANNEL": "stderr",
