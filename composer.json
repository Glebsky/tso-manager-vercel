{
    "name": "tso/public-market",
    "type": "project",
    "description": "Read-only public market portal (Vercel serverless build).",
    "keywords": ["laravel", "market", "vercel"],
    "license": "MIT",
    "require": {
        "php": "^8.2 || ^8.5",
        "laravel/framework": "^12.0",
        "sentry/sentry-laravel": "^4.27"
    },
    "require-dev": {
        "laravel/pint": "^1.13"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
