APP_NAME="TSO Public Market"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

LOG_CHANNEL=stderr
LOG_LEVEL=error

# Sentry Monitoring
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# Read-only market database (Supabase / Postgres).
# On Vercel use the connection pooler host, never the direct db.*.supabase.co host.
DB_CONNECTION=pgsql
DB_HOST=aws-0-eu-west-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=

# Serverless friendly drivers: nothing is written to disk.
CACHE_STORE=array
CACHE_DRIVER=array
SESSION_DRIVER=cookie
QUEUE_CONNECTION=sync

# Market portal
MARKET_DEFAULT_SERVER_ID=ru
MARKET_CACHE_STRATEGY=bulk
